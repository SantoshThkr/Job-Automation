#!/usr/bin/env bash
# Last check before anything leaves this machine: every commit about to be pushed is scanned for private files,
# your personal details and credentials. Bypass on purpose only: git push --no-verify
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
py="$root/backend/.venv/bin/python"; [ -x "$py" ] || py="$(command -v python3)"
zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                     # deleting a remote branch: nothing is sent
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"    # a new branch: everything reachable from it
  else range="$remote_sha..$local_sha"; fi
  "$py" "$root/scripts/privacy_check.py" --range "$range" || status=1
done
exit $status
