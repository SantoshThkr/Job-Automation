# Personal Job Assistant - copy to .env and adjust. Every value has a sensible default.
# Relative paths are resolved from the project root (this folder).

# --- Paths -------------------------------------------------------------------
PJA_DATA_DIR=data                       # SQLite DB, logs, screenshots, browser session
PJA_PROFILE_PATH=config/profile.json    # your candidate profile (facts + preferences)
PJA_RESUMES_DIR=resumes                 # where uploaded resumes are stored
# PJA_DATABASE_URL=sqlite:///data/jobs.db   # optional override (PostgreSQL URLs also work with SQLAlchemy)

# --- API / dashboard ---------------------------------------------------------
PJA_API_HOST=127.0.0.1                  # keep on loopback: the API serves your profile and controls the agent
PJA_API_PORT=8010                       # not 8000: other programs (e.g. another project's container) often use it
PJA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   # exact origins only, never *

# --- API protection (defaults are right for a single machine; see README "Security & privacy") ---
# Host names the API answers to (a request for any other name - DNS rebinding - is refused)
PJA_ALLOWED_HOSTS=localhost,127.0.0.1,::1,host.docker.internal
# Shared secret between the dashboard server and the API. Leave empty on a single machine. It becomes REQUIRED
# (24+ characters) if PJA_API_HOST is not a loopback address - the API refuses to start without it.
# Generate one:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
PJA_API_TOKEN=
PJA_API_DOCS=false                      # true = enable /docs and /openapi.json (development only)
PJA_RATE_LIMIT_ENABLED=true
PJA_MAX_REQUEST_BYTES=1048576           # largest JSON request (1 MB)
PJA_MAX_UPLOAD_BYTES=10485760           # largest resume upload (10 MB)
PJA_HTTPS=false                         # true only behind HTTPS: adds Strict-Transport-Security
# Dashboard server only (read by frontend/proxy.ts, never sent to the browser):
# PJA_BACKEND_URL=http://127.0.0.1:8010    # (make dev sets it from PJA_API_PORT)
# PJA_DASHBOARD_HOSTS=                  # extra host names the dashboard may be opened under (comma separated)

# --- Browser agent -----------------------------------------------------------
PJA_BROWSER_HEADLESS=false              # keep false: you need to see the window for login / CAPTCHA / OTP
PJA_BROWSER_CHANNEL=                    # empty = Playwright Chromium; "chrome" = your installed Google Chrome
PJA_BROWSER_PROFILE_DIR=data/browser-profile   # persistent session (log in once per portal)
PJA_BROWSER_SLOW_MO_MS=0
PJA_NAV_TIMEOUT_MS=30000
PJA_ACTION_TIMEOUT_MS=10000
PJA_HUMAN_DELAY_MS_MIN=250              # small random pauses between actions
PJA_HUMAN_DELAY_MS_MAX=900
PJA_LOGIN_WAIT_TIMEOUT_S=600            # how long to wait for you to log in
PJA_REVIEW_WAIT_TIMEOUT_S=900           # how long Review Mode waits for Approve / Reject

# --- Local AI (Ollama) -------------------------------------------------------
PJA_AI_ENABLED=true
PJA_OLLAMA_URL=http://127.0.0.1:11434   # use the address, not "localhost" (which may reach another server on ::1)
PJA_OLLAMA_MODEL=qwen3:4b               # any local model works, e.g. llama3.1:8b, qwen2.5:7b
PJA_OLLAMA_TIMEOUT_S=90
PJA_OLLAMA_KEEP_ALIVE=30s               # how long the model stays in memory after a request (~3 GB while loaded)

# --- Memory safety -----------------------------------------------------------
PJA_RECONSIDER_SKIPPED=true             # at run start, look again at jobs skipped under older preferences (preview: app.cli reevaluate --skipped --dry)
PJA_MEMORY_GUARD=true                   # check the Mac's memory before each application (pressure, swap, free disk)
PJA_AI_MODEL_MEMORY_MB=3200             # memory the local model needs; it is not loaded when less headroom is left (0 = no check)
PJA_MEMORY_WAIT_S=120                   # out of memory: wait this long for it to recover, then stop (jobs stay queued)
PJA_BROWSER_DISK_CACHE_MB=100           # cap of the agent browser's HTTP cache on disk (0 = Chrome's default)
PJA_AI_MIN_CONFIDENCE=0.75              # answers below this go to manual review

# --- Agent -------------------------------------------------------------------
PJA_DEFAULT_MODE=dry_run                # dry_run | review | auto
PJA_LOG_LEVEL=INFO
PJA_AUTO_HUMAN_WAIT_S=180               # Auto Apply: wait this long for you (CAPTCHA/OTP/question/sign-in), then park the job
PJA_NOTIFY=true                         # macOS notification whenever the agent needs you

# --- Navigator (generic browser agent for company career sites) -------------
PJA_NAVIGATOR_ENABLED=true
PJA_NAVIGATOR_USE_AI=true               # ask the local model when the rules do not understand a page
PJA_NAVIGATOR_MAX_STEPS=45
PJA_NAVIGATOR_MAX_MINUTES=15
# Optional: password for employer career-site accounts (Workday, SuccessFactors, Taleo, iCIMS...).
# With it the agent signs in with your profile email and may create an account when a site requires one
# (never in Dry Run). Leave empty to be asked to sign in yourself. Use a password you use only for job sites.
# This is a secret: it lives only in your local .env (git-ignored), is never logged and never returned by the API.
PJA_ATS_ACCOUNT_PASSWORD=
PJA_ATS_CREATE_ACCOUNTS=true
# Sign-ins for single sites are NOT kept in this file: store them in the macOS Keychain with
#   make site-login SITE=careers.example.com        (macOS asks for the password itself)
# They are used on that site only, and before the general password above. false = never ask the Keychain.
PJA_SITE_LOGIN_KEYCHAIN=true
# "Sign in with Google" on a career site: the assistant opens Google's own page and waits for you there
# (it types nothing on it - account, password, 2-step verification and consent are yours). false = leave such buttons alone.
PJA_GOOGLE_SIGNIN=true
